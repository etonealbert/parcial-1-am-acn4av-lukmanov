<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/columnMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:contentDescription="@string/desc_logo"
                    android:src="@drawable/ic_pushup" />

                <LinearLayout
                    android:id="@+id/headerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_albertup"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/section_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_today"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/body_text_size" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/body_text_size" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/accent_container"
                    android:padding="@dimen/spacing_small"
                    android:text="@string/streak_3day"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text_size" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/card_radius"
                app:contentPadding="@dimen/card_padding"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/card_stroke">

                <LinearLayout
                    android:id="@+id/todayColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTodayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/section_title_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/statReps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTodayRepsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_reps_value"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/stat_number_size"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTodayRepsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_reps_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/stat_label_size" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/statSets"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTodaySetsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_sets_value"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/stat_number_size"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTodaySetsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_sets_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/stat_label_size" />

                        </LinearLayout>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressDaily"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:max="100"
                        android:progress="42"
                        android:progressTint="@color/accent_volt" />

                    <TextView
                        android:id="@+id/tvDailyGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/daily_goal_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/body_text_size" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvChooseExercise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/choose_exercise"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/selectorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPush"
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:contentDescription="@string/desc_push"
                    android:src="@drawable/ic_pushup" />

                <Button
                    android:id="@+id/btnPushups"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stepper_button_size"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/pushups"
                    android:textSize="@dimen/body_text_size" />

                <ImageView
                    android:id="@+id/ivPull"
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:contentDescription="@string/desc_pull"
                    android:src="@drawable/ic_pullup" />

                <Button
                    android:id="@+id/btnPullups"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stepper_button_size"
                    android:layout_weight="1"
                    android:text="@string/pullups"
                    android:textSize="@dimen/body_text_size" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/card_radius"
                app:contentPadding="@dimen/card_padding"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/card_stroke">

                <LinearLayout
                    android:id="@+id/loggerColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRepsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reps_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/body_text_size" />

                    <LinearLayout
                        android:id="@+id/stepperRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMinus"
                            android:layout_width="@dimen/stepper_button_size"
                            android:layout_height="@dimen/stepper_button_size"
                            android:contentDescription="@string/decrease_desc"
                            android:text="@string/decrease"
                            android:textSize="@dimen/button_text_size" />

                        <TextView
                            android:id="@+id/tvRepCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:layout_marginEnd="@dimen/spacing_medium"
                            android:text="@string/rep_count_12"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/stepper_number_size"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPlus"
                            android:layout_width="@dimen/stepper_button_size"
                            android:layout_height="@dimen/stepper_button_size"
                            android:contentDescription="@string/increase_desc"
                            android:text="@string/increase"
                            android:textSize="@dimen/button_text_size" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLog"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/log_button"
                        android:textSize="@dimen/button_text_size" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTodaysSetsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/todays_sets_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivEmpty"
                android:layout_width="@dimen/empty_image_size"
                android:layout_height="@dimen/empty_image_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:contentDescription="@string/desc_empty"
                android:src="@drawable/img_empty_sets" />

            <LinearLayout
                android:id="@+id/setsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:contentPadding="@dimen/set_row_padding"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSet1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/set1_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/body_text_size" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:contentPadding="@dimen/set_row_padding"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSet2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/set2_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/body_text_size" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:contentPadding="@dimen/set_row_padding"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSet3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/set3_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/body_text_size" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPrTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/pr_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/prRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:contentPadding="@dimen/card_padding"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPrPushLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pr_pushups_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/body_text_size" />

                        <TextView
                            android:id="@+id/tvPrPushValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pr_pushups_value"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/section_title_size"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:contentPadding="@dimen/card_padding"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPrPullLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pr_pullups_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/body_text_size" />

                        <TextView
                            android:id="@+id/tvPrPullValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pr_pullups_value"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/section_title_size"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/accent_container"
                app:cardCornerRadius="@dimen/card_radius"
                app:contentPadding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPrTotalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pr_total_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/body_text_size" />

                    <TextView
                        android:id="@+id/tvPrTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/pr_total_value"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/section_title_size"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMotivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:gravity="center"
                android:text="@string/motivation_text"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_text_size" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
